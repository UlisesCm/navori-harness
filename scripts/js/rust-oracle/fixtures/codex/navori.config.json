{
  "$schema": "https://ulisescm.github.io/navori-harness/schema/navori.config.v1.json",
  "name": "x",
  "version": "1.0.0",
  "harnessVersion": "0.12.2",
  "engines": ["codex"],
  "preset": "nextjs",
  "language": "es",
  "branchBase": "main",
  "gitignoreHarness": "local",
  "commits": "conventional-es",
  "qualityGate": { "fast": "bun run check:fast", "full": "bun run check" },
  "models": { "implementer": "sonnet", "orchestrator": "opus" },
  "effort": { "implementer": "medium" },
  "plugins": {
    "engram": { "enabled": true },
    "tgrep": { "enabled": true }
  },
  "project": { "libraries": ["zod-validation"] }
}
