{
  "$schema": "https://ulisescm.github.io/navori-harness/schema/navori.config.v1.json",
  "name": "x",
  "version": "1.0.0",
  "harnessVersion": "0.12.2",
  "engines": [
    "claude"
  ],
  "preset": "custom",
  "language": "en",
  "branchBase": "main",
  "gitignoreHarness": "off",
  "commits": "conventional-es",
  "audit": {
    "mode": "opt-in"
  },
  "plugins": {
    "engram": {
      "enabled": true
    }
  },
  "project": {
    "legacyPaths": [],
    "criticalAreas": [],
    "criticalPaths": [],
    "testsExclude": [],
    "localSkills": [],
    "libraries": [],
    "libraryMigrations": [],
    "codeLanguage": "js"
  },
  "bogusKey": 1,
  "harness": {
    "masterPlan": true
  }
}
