{
  "$schema": "https://ulisescm.github.io/navori-harness/schema/navori.config.v1.json",
  "name": "mono",
  "version": "1.0.0",
  "harnessVersion": "0.12.2",
  "engines": [
    "claude"
  ],
  "preset": "custom",
  "language": "es",
  "branchBase": "main",
  "gitignoreHarness": "off",
  "commits": "conventional-es",
  "audit": {
    "mode": "opt-in"
  },
  "plugins": {
    "engram": {
      "enabled": true
    }
  },
  "project": {
    "legacyPaths": [],
    "criticalAreas": [],
    "criticalPaths": [],
    "testsExclude": [],
    "localSkills": [],
    "libraries": [],
    "libraryMigrations": [],
    "codeLanguage": "js"
  },
  "monorepo": {
    "enabled": true,
    "tool": "npm",
    "workspaces": [
      {
        "name": "api",
        "path": "apps/api",
        "libraries": [
          "hono"
        ]
      },
      {
        "name": "web",
        "path": "apps/web"
      }
    ],
    "workspaceHarness": "minimal"
  }
}
