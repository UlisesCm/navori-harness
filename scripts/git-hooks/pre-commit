#!/usr/bin/env bash
# navori pre-commit gate — the fast local pass.
#
# Runs `check:fast` (format, check:dup, check:ast, lint, typecheck) and NO tests.
# Tests run only in CI on `main` (`bun check`, coverage included); CI on `dev`
# runs the same set as this hook. Semgrep runs only as a `main` CI job.
set -euo pipefail

# `bun check` exercises Git commits in its fixtures. A nested hook invocation
# must not recursively restart the gate from inside that gate.
if [[ "${NAVORI_PRE_COMMIT_RUNNING:-}" == "1" ]]; then
  exit 0
fi

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

# Session-state ceiling (#1266) for HUMAN commits: the agent-side lane lives in the
# `guard-destructive` hook, which never sees a commit typed in a terminal. The check is
# the shared partial itself, sourced as-is (no third copy); only the ceiling differs,
# read from the one TS constant instead of the render-time placeholder.
# A checkout without the partial (a fixture, a sparse tree) skips only this check, never
# the probe/gate that follows.
navori_ratchet_partial="$ROOT/packages/core/core-assets/hooks/_partials/progress-ratchet.sh"
if [[ -f "$navori_ratchet_partial" ]]; then
  # shellcheck source=packages/core/core-assets/hooks/_partials/progress-ratchet.sh
  source "$navori_ratchet_partial"
  navori_progress_hard_cap=$(bun -e 'import { PROGRESS_HARD_CAP_BYTES as c } from "./packages/cli/src/lib/assets/doc-budgets.ts"; console.log(c)' 2>/dev/null || true)
  case "$navori_progress_hard_cap" in
    '' | *[!0-9]*)
      echo "pre-commit: could not read the session-state ceiling; skipping that check." >&2
      ;;
    *)
      for navori_pf in "progress/current.md" ".claude/progress/current.md" ".codex/progress/current.md"; do
        navori_progress_ratchet "$navori_pf" || exit 2
      done
      ;;
  esac
fi

SCRUB_GIT=(
  -u GIT_ALTERNATE_OBJECT_DIRECTORIES -u GIT_CONFIG -u GIT_CONFIG_PARAMETERS
  -u GIT_CONFIG_COUNT -u GIT_OBJECT_DIRECTORY -u GIT_DIR -u GIT_WORK_TREE
  -u GIT_IMPLICIT_WORK_TREE -u GIT_GRAFT_FILE -u GIT_INDEX_FILE
  -u GIT_NO_REPLACE_OBJECTS -u GIT_REPLACE_REF_BASE -u GIT_PREFIX
  -u GIT_SHALLOW_FILE -u GIT_COMMON_DIR
)

# Spec 0054 D1: a green `navori gate fast` recorded for exactly the bytes in this
# commit's index makes the run redundant. `GIT_INDEX_FILE` (git may point it at a
# temporary index, e.g. `git commit <path>`) is the only GIT_* the probe keeps, made
# absolute. Any exit but 0 (miss, crash, bun missing, an older CLI) runs the gate.
probe_index=()
if [[ -n "${GIT_INDEX_FILE:-}" ]]; then
  case "$GIT_INDEX_FILE" in
    /*) probe_index=("GIT_INDEX_FILE=$GIT_INDEX_FILE") ;;
    *) probe_index=("GIT_INDEX_FILE=$ROOT/$GIT_INDEX_FILE") ;;
  esac
fi
if env "${SCRUB_GIT[@]}" ${probe_index[@]+"${probe_index[@]}"} \
  bun packages/cli/src/index.ts gate probe --index >/dev/null 2>&1; then
  echo "▶ pre-commit: check:fast already green for these exact bytes (navori gate cache); skipped."
  exit 0
fi

echo "▶ pre-commit: running check:fast (no tests)…"
export NAVORI_PRE_COMMIT_RUNNING=1
# No check:fast step may read or write the commit's index: scrub the GIT_*
# variables a hook inherits so any git call a step makes targets the repo, not it.
env "${SCRUB_GIT[@]}" bun run check:fast
