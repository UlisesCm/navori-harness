#!/usr/bin/env bash
# navori pre-push gate — versioned companion of qualityGate.full.
#
# Keep this deliberately thin: package.json's check script is asserted against
# navori.config.json's qualityGate.full, so this hook cannot promise more (or
# less) than the gate that reviewers and commit-pr-pilot use.
set -euo pipefail

# `bun check` exercises Git pushes in its fixtures. A nested hook invocation
# must not recursively restart the full gate from inside that gate.
if [[ "${NAVORI_PRE_PUSH_RUNNING:-}" == "1" ]]; then
  exit 0
fi

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

echo "▶ pre-push: running qualityGate.full…"
export NAVORI_PRE_PUSH_RUNNING=1
exec bun check
