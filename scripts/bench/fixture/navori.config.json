{
  "name": "navori-live-fixture",
  "preset": "custom",
  "engines": ["claude", "pi"],
  "branchBase": "main",
  "packageManager": "npm",
  "qualityGate": { "fast": "npm test", "full": "npm test" },
  "harness": { "planTiers": true, "scribeOwnsMarkdown": true },
  "models": {
    "orchestrator": "sonnet", "implementer": "sonnet", "reviewer": "sonnet",
    "scout": "sonnet", "auditor": "sonnet", "publisher": "sonnet",
    "scribe": "sonnet", "architect": "sonnet"
  },
  "plugins": {
    "tgrep": { "enabled": true }, "engram": { "enabled": false },
    "codegraph": { "enabled": false }, "gh": { "enabled": false }, "acli": { "enabled": false }
  }
}
