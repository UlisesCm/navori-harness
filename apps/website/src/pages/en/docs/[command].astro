---
import LegacyRedirect from "../../../components/LegacyRedirect.astro";
import { commandOrder } from "../../../content/commands";
export function getStaticPaths() { return commandOrder.map((command) => ({params: {command},props:{page:`docs/${command}` as const}})); }
const { page } = Astro.props;
---
<LegacyRedirect lang="en" page={page} />
