---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import Trustband from "../../components/sections/Trustband.astro";
import HarnessGraph from "../../components/sections/HarnessGraph.astro";
import Problem from "../../components/sections/Problem.astro";
import Scopes from "../../components/sections/Scopes.astro";
import Layers from "../../components/sections/Layers.astro";
import Flow from "../../components/sections/Flow.astro";
import Toolbox from "../../components/sections/Toolbox.astro";
import Audit from "../../components/sections/Audit.astro";
import Commands from "../../components/sections/Commands.astro";
import Engines from "../../components/sections/Engines.astro";
import Quickstart from "../../components/sections/Quickstart.astro";
import FAQ from "../../components/sections/FAQ.astro";

const lang = "en" as const;
---

<BaseLayout lang={lang}>
