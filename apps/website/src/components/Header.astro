---
import Logo from "./Logo.astro";
import { useTranslations, localizedPath } from "../i18n/utils";
import type { Lang } from "../i18n/ui";
import { localeOrder, locales } from "../i18n/locales";
import { pagePath, type PageId } from "../content/pages";
import { REPO_URL } from "../consts";

interface Props {
  lang: Lang;
  page: PageId;
}

const { lang, page } = Astro.props;
const t = useTranslations(lang);

---

<header
  class="sticky top-0 z-40 w-full border-b"
  style="border-color: var(--color-border-soft); background: var(--color-ivory);"
  data-header
>
  <div class="container-prose flex min-h-14 flex-wrap items-center justify-between gap-y-1 py-2">
    <Logo />

    <button type="button" class="site-menu-toggle" data-menu-toggle aria-controls="primary-navigation" aria-expanded="false">
      {t("nav.menu")}
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
    </button>
    <nav id="primary-navigation" aria-label={t("nav.menu")} class="primary-navigation flex flex-wrap items-center justify-end gap-0 sm:gap-1 text-[13px] sm:text-sm">
      <a
        href={localizedPath(lang, "/deep-dive")}
        class="whitespace-nowrap px-1 sm:px-3 py-2 rounded-md hover:text-sky-700 dark:hover:text-sky-300 transition-colors"
      >
        {t("nav.deepdive")}
      </a>
      <a
        href={localizedPath(lang, "/docs/init")}
        class="whitespace-nowrap px-1 sm:px-3 py-2 rounded-md hover:text-sky-700 dark:hover:text-sky-300 transition-colors"
      >
        {t("nav.docs")}
      </a>
      <a
        href={localizedPath(lang, "/quickstart")}
        class="whitespace-nowrap px-1 sm:px-3 py-2 rounded-md hover:text-sky-700 dark:hover:text-sky-300 transition-colors"
      >
        {t("nav.quickstart")}
      </a>
      <span
        class="mx-2 hidden h-4 w-px sm:inline-block"
        style="background: var(--color-border-soft);"></span>
      <a
        href={REPO_URL}
        target="_blank"
        rel="noreferrer"
        class="hidden sm:inline-flex items-center gap-1.5 px-3 py-2 rounded-md hover:text-sky-700 dark:hover:text-sky-300 transition-colors"
      >
        <svg
          width="14"
          height="14"
          viewBox="0 0 16 16"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M8 0C3.58 0 0 3.58 0 8a8 8 0 005.47 7.59c.4.07.55-.17.55-.38v-1.34c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.05-.49.05-.49.8.06 1.23.83 1.23.83.72 1.22 1.87.87 2.33.66.07-.52.28-.87.5-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.22 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.74.54 1.49v2.2c0 .21.15.46.55.38A8 8 0 0016 8c0-4.42-3.58-8-8-8z"
          ></path>
        </svg>
        GitHub
      </a>

      <button
        type="button"
        class="ml-0 sm:ml-1 inline-flex items-center justify-center h-9 w-9 rounded-md hover:bg-black/5 dark:hover:bg-white/10 transition-colors"
        aria-label={t("theme.toggle")}
        data-theme-toggle
      >
        <svg
          class="hidden dark:inline-block"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
        </svg>
        <svg
          class="dark:hidden"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"></path>
        </svg>
      </button>

      <nav aria-label={t("lang.label")} class="flex flex-wrap gap-1">
        {localeOrder.map((locale) => <a href={pagePath(locale, page, import.meta.env.BASE_URL)} hreflang={locale} lang={locale} aria-current={locale === lang ? "page" : undefined} data-language-link class="rounded-md px-2 py-2 text-xs hover:bg-black/5 dark:hover:bg-white/10">{locales[locale].name}</a>)}
      </nav>
    </nav>
  </div>
</header>

<script is:inline>
  // theme bootstrap and toggle — runs inline to avoid FOUC
  (function () {
    let stored = null;
    try { stored = localStorage.getItem("navori-theme"); } catch { /* Storage can be unavailable in private contexts. */ }
    const prefersDark = window.matchMedia(
      "(prefers-color-scheme: dark)",
    ).matches;
    const initial = stored ?? (prefersDark ? "dark" : "light");
    if (initial === "dark") document.documentElement.classList.add("dark");

    document.addEventListener("click", (e) => {
      const target = e.target;
      if (!(target instanceof Element)) return;
      const btn = target.closest("[data-theme-toggle]");
      if (!btn) return;
      const isDark = document.documentElement.classList.toggle("dark");
      try { localStorage.setItem("navori-theme", isDark ? "dark" : "light"); } catch { /* The current page still changes theme. */ }
    });
  })();
</script>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  const menu = header?.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const navigation = header?.querySelector<HTMLElement>("#primary-navigation");
  if (header && menu && navigation) {
    header.dataset.menuReady = "true";
    const setOpen = (open: boolean): void => {
      navigation.dataset.open = String(open);
      menu.setAttribute("aria-expanded", String(open));
    };
    menu.addEventListener("click", () => setOpen(menu.getAttribute("aria-expanded") !== "true"));
    header.addEventListener("keydown", (event: KeyboardEvent) => {
      if (event.key === "Escape" && menu.getAttribute("aria-expanded") === "true") { setOpen(false); menu.focus(); }
    });
    document.addEventListener("click", (event: MouseEvent) => {
      if (event.target instanceof Node && !header.contains(event.target)) setOpen(false);
    });
    window.matchMedia("(min-width: 901px)").addEventListener("change", (event: MediaQueryListEvent) => {
      if (event.matches) setOpen(false);
    });
  }
  // Canonical editions share stable semantic IDs. Plain links still work without JS.
  document.querySelectorAll<HTMLAnchorElement>("[data-language-link]").forEach((link) => {
    link.addEventListener("click", () => {
      const fragment = window.location.hash;
      if (fragment && document.getElementById(decodeURIComponent(fragment.slice(1)))) {
        const url = new URL(link.href);
        url.hash = fragment;
        link.href = url.href;
      }
    });
  });
</script>
