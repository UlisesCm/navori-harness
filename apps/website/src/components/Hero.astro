---
import { useTranslations, localizedPath } from "../i18n/utils";
import type { Lang } from "../i18n/ui";
import HeroTerminal from "./HeroTerminal.astro";
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
---
<section class="home-intro">
  <div class="container-prose home-intro-grid">
    <div class="home-intro-copy">
    <h1>
      <span>{t("hero.headlineA")}</span>
      <span class="home-intro-emphasis">{t("hero.headlineB")}</span>
    </h1>
    <div class="home-intro-description">
      <p>{t("hero.subhead")}</p>
      <div class="home-intro-actions">
        <a class="btn btn-primary" href="#anatomy">{t("hero.cta.demo")}<span aria-hidden="true">↓</span></a>
        <a class="home-intro-link" href={localizedPath(lang, "/quickstart")}>{t("hero.cta.primary")}<span aria-hidden="true">↗</span></a>
      </div>
    </div>
    </div>
    <div class="home-intro-terminal"><HeroTerminal /></div>
  </div>
</section>
