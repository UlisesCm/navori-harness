---
interface Props {
  eyebrow: string;
  title: string;
  subtitle?: string;
  align?: "center" | "left";
  /** Heading tag for the title; full pages pass "h1". */
  as?: "h1" | "h2";
}
const { eyebrow, title, subtitle, align = "center", as: Heading = "h2" } = Astro.props;
const [head = "", ...rest] = title.split(",");
const hasComma = rest.length > 0;
const tail = rest.join(",").trim();
---

<div
  class:list={[
    "max-w-3xl",
    align === "center" ? "mx-auto text-center" : "text-left",
  ]}
>
  <span
    class="text-xs font-medium uppercase tracking-[0.22em] text-violet-700 dark:text-violet-300"
  >
    {eyebrow}
  </span>
  <Heading
    class="mt-3 text-[clamp(1.85rem,4vw,2.75rem)] leading-[1.1] tracking-tight"
  >
    <span class="font-sans font-semibold">{hasComma ? `${head},` : head}</span>{
      hasComma && (
        <span class="display-italic gradient-text">{" "}{tail}</span>
      )
    }
  </Heading>
  {
    subtitle && (
      <p class="mt-4 text-base sm:text-lg text-slate-600 dark:text-slate-400">
        {subtitle}
      </p>
    )
  }
</div>
