---
/**
 * All 21 subcommands, grouped by the moment you need them.
 *
 * The previous version showed 8 of 21 as a flat tab strip — and the 13 missing
 * ones included `audit`, `global` and `dominio`, i.e. everything that changed
 * about navori since the page was written. A flat list of 21 tabs would be
 * unreadable, so the fix is grouping: five lifecycle stages, the command names
 * linking to their reference page.
 *
 * `commandOrder` from `content/commands.ts` is the registry this must cover.
 * The inventory test asserts that every id listed here exists there and that
 * none is missing, so the next command can't ship unmentioned.
 */
import SectionHeader from "../SectionHeader.astro";
import { useTranslations, localizedPath } from "../../i18n/utils";
import type { Lang } from "../../i18n/ui";
import { COMMAND_GROUPS } from "../../content/command-groups";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);


const groups = COMMAND_GROUPS.map((g) => ({
  ...g,
  label: t(g.labelKey as Parameters<typeof t>[0]),
  items: g.commands.map((id) => ({
    id,
    desc: t(`commands.${id}.desc` as Parameters<typeof t>[0]),
  })),
}));
---

<section class="py-24 sm:py-28">
  <div class="container-prose">
    <SectionHeader
      eyebrow={t("commands.eyebrow")}
      title={t("commands.title")}
      subtitle={t("commands.subtitle")}
    />

    <div class="mt-14 space-y-10">
      {
        groups.map((g) => (
          <div class="grid gap-5 lg:grid-cols-[200px_1fr]">
            <div class="lg:pt-1">
              <h3 class="flex items-center gap-2.5 text-xs font-mono uppercase tracking-[0.18em]">
                <span
                  class="h-2 w-2 rounded-full shrink-0"
                  style={`background:${g.accent};`}
                  aria-hidden="true"
                />
                <span style={`color:${g.accent};`}>{g.label}</span>
              </h3>
            </div>

            <ul class="grid gap-px sm:grid-cols-2 xl:grid-cols-3">
              {g.items.map((c) => (
                <li>
                  <a
                    href={localizedPath(lang, `/docs/${c.id}`)}
                    class="group block h-full rounded-lg border border-transparent p-4 transition-colors hover:border-[var(--color-border-soft)] hover:bg-white/60 dark:hover:bg-white/5"
                  >
                    <span class="flex items-baseline gap-1.5">
                      <span class="font-mono text-[11px] text-slate-400 select-none">navori</span>
                      <span class="font-mono text-sm font-medium">{c.id}</span>
                    </span>
                    <span class="mt-1.5 block text-xs leading-snug text-slate-500 dark:text-slate-400">
                      {c.desc}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="mt-12 flex justify-center">
      <a class="btn btn-ghost" href={localizedPath(lang, "/docs/init")}>
        {t("commands.docsCta")}
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M5 12h14M13 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>
  </div>
</section>
