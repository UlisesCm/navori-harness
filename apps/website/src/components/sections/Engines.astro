---
import SectionHeader from "../SectionHeader.astro";
import { useTranslations } from "../../i18n/utils";
import type { Lang } from "../../i18n/ui";
import claudeSvg from "../../assets/engines/claude.svg?raw";
import cursorSvg from "../../assets/engines/cursor.svg?raw";
import copilotSvg from "../../assets/engines/githubcopilot.svg?raw";
import agentsSvg from "../../assets/engines/agents.svg?raw";
import { landingCopy } from "../../content/landing";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const engines = [
  {
    name: "Claude Code",
    path: ".claude/",
    detail: t("engines.claude.detail"),
    logo: claudeSvg,
  },
  {
    name: "Codex",
    path: ".codex/ + .agents/skills/",
    detail: t("engines.codex.detail"),
    logo: agentsSvg,
  },
  {
    name: "AGENTS.md",
    path: "AGENTS.md",
    detail: t("engines.agentsmd.detail"),
    logo: agentsSvg,
  },
  {
    name: "Cursor",
    path: ".cursor/rules/",
    detail: t("engines.cursor.detail"),
    logo: cursorSvg,
  },
  {
    name: "Copilot",
    path: ".github/copilot-instructions.md",
    detail: t("engines.copilot.detail"),
    logo: copilotSvg,
  },
  {
    name: "Pi",
    path: ".pi/",
    detail: t("engines.pi.detail"),
    logo: agentsSvg,
  },
];

// Official brand SVGs ship with a baked-in fill; recolor them to inherit the
// tile's white text and size them consistently.
const renderLogo = (svg: string): string =>
  svg
    .replace(/fill="#[0-9A-Fa-f]+"/, 'fill="currentColor"')
    .replace("<svg ", '<svg class="h-6 w-6" aria-hidden="true" ');
---

<section
  id="engines"
  class="relative py-24 sm:py-28 border-y overflow-hidden"
  style="border-color: var(--color-border-soft);"
>
  <div class="absolute inset-0 grid-bg pointer-events-none opacity-60"></div>

  <div class="container-prose relative">
    <SectionHeader
      title={landingCopy[lang].engines.title}
      subtitle={landingCopy[lang].engines.body}
    />

    <div class="mt-12 grid gap-x-8 gap-y-0 sm:grid-cols-2 lg:grid-cols-3">
      {
        engines.map((e) => (
          <article class="border-t py-6" style="border-color: var(--color-border-soft);">
            <div class="flex items-center gap-3">
              <div
                class:list={[
                  "h-9 w-9 rounded-lg bg-sky-700 dark:bg-sky-800 shrink-0",
                  "flex items-center justify-center text-white",
                ]}
                set:html={renderLogo(e.logo)}
              />
              <h3 class="text-base font-semibold tracking-tight">{e.name}</h3>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
              {e.detail}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>
