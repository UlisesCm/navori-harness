---
import { landingCopy } from "../../content/landing";
import { sessionAnimation } from "../../content/session-animation";
import type { Lang } from "../../i18n/ui";

interface Props { lang: Lang }
const { lang } = Astro.props;
const controls = landingCopy[lang].session;
const copy = sessionAnimation[lang];
const drawers = [0, 1, 2];
const papers = Array.from({ length: 8 }, (_: unknown, index: number): number => index);
---

<section id="anatomy" class="session-section" aria-labelledby="session-title">
  <div class="container-prose">
    <div class="session-intro">
      <h2 id="session-title">{copy.title}</h2>
      <p>{copy.introduction}</p>
    </div>

    <div class="session-demo" data-session data-playing="false"
      data-play-label={controls.play} data-pause-label={controls.pause} data-replay-label={controls.replay}
      data-beats={JSON.stringify(copy.beats)}>
      <div class="demo-toolbar">
        <p>{controls.example}</p>
        <button type="button" data-toggle hidden>{controls.play}</button>
      </div>

      <div class="session-layout">
        <aside class="session-console" aria-label={controls.console}>
          <div class="console-heading">
            <span class="console-light" aria-hidden="true"></span>
            <span>navori — session</span>
          </div>
          <ol class="console-messages" data-transcript>
            {copy.conversation.map((line) => (
              <li class={`message-${line.speaker}`} data-message data-at={line.at} data-text={line.text}>
                <span class="message-speaker">{line.speaker === "user" ? controls.user : line.speaker === "tool" ? "tools" : controls.assistant}</span>
                <p data-message-text>{line.text}</p>
              </li>
            ))}
          </ol>
          <div class="console-input" aria-hidden="true"><span>❯</span><span class="console-cursor"></span></div>
        </aside>

        <div class="animation-stage">
          <svg class="workshop" viewBox="0 0 960 620" role="img" aria-label={copy.scene}>
            <defs>
              <linearGradient id="cabinet-surface" x1="0" x2="1" y1="0" y2="1">
                <stop offset="0" stop-color="var(--archive-front)" />
                <stop offset="1" stop-color="var(--archive-side)" />
              </linearGradient>
              <linearGradient id="chip-surface" x1="0" x2="1" y1="0" y2="1">
                <stop offset="0" stop-color="#73e3f1" /><stop offset="1" stop-color="#268bb9" />
              </linearGradient>
            </defs>

            <path class="floor-line" d="M65 530H895" />
            <ellipse class="floor-shadow" cx="480" cy="537" rx="330" ry="23" />

            <g class="filing-cabinet" data-cabinet="engram">
              <path class="cabinet-side" d="M320 190l24 18v312l-24 10z" />
              <rect class="cabinet-shell" x="130" y="190" width="190" height="340" rx="12" />
              <rect class="cabinet-label" x="149" y="208" width="152" height="44" rx="5" />
              <text class="cabinet-brand" x="225" y="237">engram</text>
              {drawers.map((index: number) => (
                <g transform={`translate(144 ${270 + index * 78})`}>
                  <rect class="drawer-recess" width="162" height="66" rx="5" />
                  <g data-drawer-left={index}>
                    <path class="drawer-top" d="M0 0l22-20h162L162 0z" />
                    <rect class="drawer-front" width="162" height="66" rx="5" />
                    <rect class="drawer-tag" x="16" y="12" width="130" height="20" rx="3" />
                    <text class="drawer-text" x="81" y="27">{index === 0 ? copy.labels.decisions : index === 1 ? copy.labels.context : "…"}</text>
                    <path class="drawer-handle" d="M64 45v5h34v-5" />
                  </g>
                </g>
              ))}
              <path class="cabinet-foot" d="M151 530v9M299 530v9" />
            </g>

            <g class="filing-cabinet" data-cabinet="codegraph">
              <path class="cabinet-side" d="M840 190l24 18v312l-24 10z" />
              <rect class="cabinet-shell" x="650" y="190" width="190" height="340" rx="12" />
              <rect class="cabinet-label" x="669" y="208" width="152" height="44" rx="5" />
              <text class="cabinet-brand" x="745" y="237">codegraph</text>
              {drawers.map((index: number) => (
                <g transform={`translate(664 ${270 + index * 78})`}>
                  <rect class="drawer-recess" width="162" height="66" rx="5" />
                  <g data-drawer-right={index}>
                    <path class="drawer-top" d="M0 0l-22-20h162L162 0z" />
                    <rect class="drawer-front" width="162" height="66" rx="5" />
                    <rect class="drawer-tag" x="16" y="12" width="130" height="20" rx="3" />
                    <text class="drawer-text" x="81" y="27">{index === 0 ? copy.labels.relationships : index === 1 ? copy.labels.files : "tgrep"}</text>
                    <path class="drawer-handle" d="M64 45v5h34v-5" />
                  </g>
                </g>
              ))}
              <path class="cabinet-foot" d="M671 530v9M819 530v9" />
            </g>

            <g transform="translate(225 345)">
              {papers.map((index: number) => (
                <g class="flying-file" data-file-left={index}>
                  <rect x="-20" y="-26" width="40" height="52" rx="4" />
                  <path d="M-10-11H10M-10 0H10M-10 11H3" />
                </g>
              ))}
            </g>
            <g transform="translate(720 345)">
              {papers.map((index: number) => (
                <g class="flying-file" data-file-right={index}>
                  <rect x="-20" y="-26" width="40" height="52" rx="4" />
                  <path d="M-10-11H10M-10 0H10M-10 11H3" />
                </g>
              ))}
            </g>

            <g transform="translate(480 520)">
              <g data-portal>
                <ellipse class="portal-shadow" rx="88" ry="14" />
                <ellipse class="portal-ring" rx="68" ry="10" />
              </g>
            </g>
            <g transform="translate(90 455)">
              <g data-prompt-packet>
                <rect class="prompt-packet" width="58" height="42" rx="9" />
                <path class="packet-glyph" d="M15 13l8 8-8 8M31 29h13" />
              </g>
            </g>

            <g transform="translate(400 320)">
              <g data-robot-move>
                <g data-robot-pop>
                  <ellipse class="robot-shadow" cx="80" cy="211" rx="57" ry="10" />
                  <g data-robot-body>
                    <path class="robot-antenna" d="M80 29V10" />
                    <circle class="robot-signal" cx="80" cy="8" r="6" />
                    <rect class="robot-shell" x="18" y="30" width="124" height="92" rx="30" />
                    <path class="robot-ear" d="M13 59v29M147 59v29" />
                    <rect class="robot-face" x="30" y="43" width="100" height="62" rx="20" />
                    <g data-robot-eyes>
                      <rect class="robot-eye" x="51" y="60" width="12" height="23" rx="6" />
                      <rect class="robot-eye" x="97" y="60" width="12" height="23" rx="6" />
                      <path class="robot-smile" d="M72 88q8 7 16 0" />
                    </g>
                    <path class="robot-neck" d="M65 125v8h30v-8" />
                    <rect class="robot-shell" x="40" y="134" width="80" height="54" rx="19" />
                    <rect class="robot-slot" x="59" y="147" width="42" height="28" rx="7" />
                    <g data-integrated-chip>
                      <rect class="integrated-core" x="64" y="151" width="32" height="20" rx="4" />
                      <path class="core-pins" d="M70 148v-4M80 148v-4M90 148v-4M70 174v4M80 174v4M90 174v4" />
                    </g>
                    <g data-arm-left>
                      <path class="robot-arm" d="M40 144Q9 151 7 120" />
                      <circle class="robot-hand" cx="7" cy="117" r="9" />
                    </g>
                    <g data-arm-right>
                      <path class="robot-arm" d="M120 144q31 7 33-24" />
                      <circle class="robot-hand" cx="153" cy="117" r="9" />
                    </g>
                    <g data-leg-left><path class="robot-leg" d="M61 188v16h-13" /></g>
                    <g data-leg-right><path class="robot-leg" d="M99 188v16h13" /></g>
                    <circle class="integration-ring" data-integration-ring cx="80" cy="161" r="35" />
                  </g>
                </g>
              </g>
            </g>

            <g transform="translate(680 430)">
              <g data-chip>
                <path class="chip-edge" d="M-29-29l12-10h58v58L29 29z" />
                <rect class="chip-front" x="-29" y="-29" width="58" height="58" rx="9" />
                <path class="chip-pins" d="M-15-29v-8M0-29v-8M15-29v-8M-15 29v8M0 29v8M15 29v8M-29-15h-8M-29 0h-8M-29 15h-8M29-15h8M29 0h8M29 15h8" />
                <path class="chip-mark" d="M-7-12H8M0-12v25M-8 13H8" />
                <g data-chip-label><rect class="chip-nameplate" x="-45" y="-70" width="90" height="30" rx="6" /><text class="chip-label" y="-49">tgrep</text></g>
              </g>
            </g>

            <g data-bubble>
              <rect class="speech-bubble" x="370" y="224" width="220" height="58" rx="15" />
              <path class="bubble-tail" d="M456 281l18 17 18-17" />
              <text class="bubble-text" x="480" y="260">{copy.labels.processing}</text>
            </g>
            <g data-speed-lines class="speed-lines">
              <path d="M370 350h-40M359 375h-60M371 400h-45M589 350h40M601 375h60M590 400h45" />
            </g>
            <g data-ready>
              <rect class="ready-pill" x="352" y="552" width="256" height="44" rx="22" />
              <path class="ready-check" d="M375 574l7 7 12-14" />
              <text class="ready-text" x="494" y="580">{copy.labels.ready}</text>
            </g>
          </svg>
          <div class="scene-caption"><span class="caption-dot" aria-hidden="true"></span><p data-caption>{copy.beats[0]}</p></div>
        </div>
      </div>
      <div class="playback-controls" data-controls hidden>
        <span data-clock aria-hidden="true">0:00</span>
        <input type="range" min="0" max="21000" step="100" value="0" aria-label={copy.timeline} data-scrub />
        <span aria-hidden="true">0:21</span>
      </div>
      <details class="transcript-details"><summary>{copy.transcript}</summary><ol>{copy.conversation.map((line) => <li><strong>{line.speaker === "user" ? controls.user : line.speaker === "tool" ? "tools" : controls.assistant}</strong> {line.text}</li>)}</ol></details>
      <p class="scene-explanation">{copy.explanation}</p>
    </div>
  </div>
</section>

<style>
  .session-section { padding-block: 6rem; border-bottom: 1px solid var(--color-border-soft); }
  .session-intro { max-width: 48rem; }
  h2 { font-size: clamp(2rem, 3.8vw, 3rem); font-weight: 600; line-height: 1.12; letter-spacing: -.03em; text-wrap: balance; }
  .session-intro > p { margin-top: 1.25rem; max-width: 65ch; font-size: 1.125rem; line-height: 1.7; color: var(--landing-muted); }
  .session-demo { margin-top: 2.5rem; }
  .demo-toolbar { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: .75rem; padding-block: 1rem; }
  .demo-toolbar > p { font-size: .75rem; color: var(--landing-muted); }
  .demo-toolbar button { border: 1px solid var(--color-border-soft); border-radius: 6px; padding: .65rem .9rem; font-size: .75rem; cursor: pointer; }
  .demo-toolbar button:hover { border-color: var(--landing-accent); }
  .session-layout { display: grid; grid-template-columns: minmax(240px, 1fr) 3fr; min-height: 580px; border-radius: 14px; overflow: hidden; border: 1px solid var(--color-border-soft); }
  .session-console { display: flex; flex-direction: column; min-width: 0; background: #0a1020; color: #dce6f5; }
  .console-heading { display: flex; align-items: center; gap: .65rem; padding: 1rem; border-bottom: 1px solid #ffffff16; font: .68rem var(--font-mono); color: #aabbd4; }
  .console-light { width: 6px; height: 6px; border-radius: 50%; background: #7dd3fc; }
  .console-messages { padding: .35rem 1rem; height: 470px; overflow-y: auto; scrollbar-width: thin; scrollbar-color: #425575 #0a1020; }
  .console-messages li { padding-block: 1rem; border-bottom: 1px solid #ffffff12; }
  .message-speaker { font: .65rem var(--font-mono); color: #8ccee8; }
  .message-user .message-speaker { color: #d4c5fd; }
  .message-tool .message-speaker { color: #b3d8bf; }
  .console-messages p { font: .76rem/1.8 var(--font-mono); margin-top: .5rem; min-height: 1.3em; overflow-wrap: anywhere; }
  .console-input { display: flex; gap: .65rem; align-items: center; padding: 1rem; margin-top: auto; font: .85rem var(--font-mono); color: #7dd3fc; }
  .console-cursor { width: 7px; height: 14px; background: #8ccee8; opacity: .65; }
  .animation-stage { --archive-front: #e5edf1; --archive-side: #c0d0da; --archive-drawer: #f0f4f5; --archive-line: #8fa5b5; --archive-ink: #263e50; min-width: 0; display: flex; flex-direction: column; justify-content: center; background-color: var(--color-ivory-2); background-image: linear-gradient(to right, var(--landing-grid) 1px, transparent 1px), linear-gradient(to bottom, var(--landing-grid) 1px, transparent 1px); background-size: 32px 32px; }
  :global(html.dark) .animation-stage { --archive-front: #26384f; --archive-side: #16243a; --archive-drawer: #30445c; --archive-line: #58708b; --archive-ink: #d5e8f0; }
  .workshop { display: block; width: 100%; height: auto; overflow: visible; }
  .floor-line { stroke: var(--archive-line); stroke-width: 1; }
  .floor-shadow, .robot-shadow { fill: var(--archive-line); opacity: .12; }
  .cabinet-side { fill: var(--archive-side); }
  .cabinet-shell { fill: url(#cabinet-surface); stroke: var(--archive-line); stroke-width: 2; }
  .cabinet-label { fill: var(--archive-drawer); stroke: var(--archive-line); }
  .cabinet-brand { fill: var(--archive-ink); text-anchor: middle; font: 600 23px var(--font-mono); }
  .drawer-recess { fill: var(--archive-side); }
  .drawer-front { fill: var(--archive-drawer); stroke: var(--archive-line); stroke-width: 1.5; }
  .drawer-top { fill: var(--archive-front); stroke: var(--archive-line); stroke-width: 1.5; opacity: 0; }
  .drawer-tag { fill: var(--archive-front); }
  .drawer-text { fill: var(--archive-ink); text-anchor: middle; font: 13px var(--font-sans); }
  .drawer-handle, .cabinet-foot { fill: none; stroke: var(--archive-line); stroke-width: 4; stroke-linecap: round; }
  .flying-file rect { fill: var(--archive-drawer); stroke: var(--landing-accent); stroke-width: 2; }
  .flying-file path { fill: none; stroke: var(--landing-accent); stroke-width: 2; }
  .portal-shadow { fill: #0a1020; opacity: .13; }
  .portal-ring { fill: none; stroke: var(--color-sky-500); stroke-width: 3; }
  .prompt-packet { fill: #0a1020; stroke: #7dd3fc; stroke-width: 2; }
  .packet-glyph { fill: none; stroke: #7dd3fc; stroke-width: 3; }
  .robot-shell { fill: var(--archive-drawer); stroke: var(--landing-accent); stroke-width: 2.5; }
  .robot-antenna, .robot-ear, .robot-neck { fill: none; stroke: var(--landing-accent); stroke-width: 4; stroke-linecap: round; }
  .robot-signal { fill: #a78bfa; }
  .robot-face, .robot-slot { fill: #0a1020; }
  .robot-eye { fill: #7dd3fc; }
  .robot-smile { fill: none; stroke: #7dd3fc; stroke-width: 2.5; stroke-linecap: round; }
  .robot-arm, .robot-leg { fill: none; stroke: var(--landing-accent); stroke-width: 8; stroke-linecap: round; }
  .robot-hand { fill: var(--archive-drawer); stroke: var(--landing-accent); stroke-width: 2.5; }
  .integrated-core { fill: #63e0df; }
  .core-pins { stroke: #63e0df; stroke-width: 2; }
  .integration-ring { fill: none; stroke: #25b6c0; stroke-width: 3; }
  .chip-edge { fill: #12688d; stroke: #0a506f; stroke-width: 2; }
  .chip-front { fill: url(#chip-surface); stroke: #0a506f; stroke-width: 2; }
  .chip-pins { fill: none; stroke: #33819a; stroke-width: 5; }
  .chip-mark { fill: none; stroke: #0a3856; stroke-width: 4; stroke-linecap: round; }
  .chip-nameplate { fill: #0a1020; }
  .chip-label { text-anchor: middle; fill: #b9ecf4; font: 19px var(--font-mono); }
  .speech-bubble, .bubble-tail { fill: var(--archive-drawer); stroke: var(--archive-line); stroke-width: 1.5; }
  .bubble-text { text-anchor: middle; fill: var(--archive-ink); font: 20px var(--font-sans); }
  .speed-lines { fill: none; stroke: #36a6b9; stroke-width: 4; stroke-linecap: round; }
  .ready-pill { fill: var(--archive-drawer); stroke: var(--archive-line); }
  .ready-check { fill: none; stroke: var(--landing-accent); stroke-width: 3; stroke-linecap: round; }
  .ready-text { text-anchor: middle; fill: var(--archive-ink); font: 18px var(--font-sans); }
  .scene-caption { display: flex; align-items: center; justify-content: center; gap: .6rem; min-height: 4rem; padding: 1rem; text-align: center; font-size: .85rem; color: var(--landing-muted); }
  .caption-dot { width: 6px; height: 6px; flex-shrink: 0; border-radius: 50%; background: var(--landing-accent); }
  .playback-controls { display: flex; align-items: center; gap: .9rem; margin-top: 1.25rem; }
  .playback-controls[hidden] { display: none; }
  .playback-controls > span { font: .68rem var(--font-mono); color: var(--landing-muted); }
  .playback-controls input { width: 100%; height: 24px; accent-color: var(--landing-accent); cursor: pointer; }
  .scene-explanation { max-width: 95ch; margin-top: 1rem; color: var(--landing-muted); font-size: .75rem; line-height: 1.75; }
  .transcript-details { margin-top: 1.25rem; font-size: .8rem; }
  .transcript-details summary { color: var(--landing-accent); cursor: pointer; padding-block: .5rem; }
  .transcript-details li { margin-top: .75rem; line-height: 1.7; color: var(--landing-muted); }
  .transcript-details strong { font-weight: 600; margin-right: .35rem; }
  .flying-file, [data-chip], [data-bubble], [data-speed-lines], [data-integrated-chip], [data-integration-ring], [data-prompt-packet], [data-portal] { opacity: 0; }
  @media (max-width: 760px) {
    .session-section { padding-block: 4rem; }
    .session-layout { grid-template-columns: 1fr; min-height: 0; }
    .console-messages { height: 210px; }
    .console-heading { padding: .75rem 1rem; }
    .console-input { padding: .5rem 1rem; }
    .workshop { width: 115%; max-width: none; margin: -1rem -7.5% 0; }
    .cabinet-brand { font-size: 28px; }
    .drawer-text { font-size: 17px; }
    .chip-label { font-size: 23px; }
    .bubble-text { font-size: 24px; }
    .scene-caption { min-height: 4.5rem; font-size: .8rem; }
  }
</style>

<script>
  import { mountSessionAnimation } from "../../scripts/session-animation";

  document.querySelectorAll<HTMLElement>("[data-session]").forEach((demo: HTMLElement): void => {
    mountSessionAnimation(demo);
  });
</script>
