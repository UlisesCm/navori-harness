---
/**
 * "What a harness actually does", as a diagram that moves.
 *
 * The landing explained navori to people who already knew what a harness was.
 * This section is for the ones who don't: four phases of a real session, walked
 * one at a time — context loads, the leader fans the work out, hooks fire at
 * fixed moments, the gate decides. The graph is the explanation, not decoration.
 *
 * Built as one inline SVG on a fixed viewBox so it scales without reflowing:
 * node coordinates are constants below, edges are derived from them, and the
 * phase highlight is pure CSS driven by `data-phase` on the root. The script
 * only advances that attribute — with JS off, or `prefers-reduced-motion` set,
 * every phase renders lit and the diagram still reads.
 */
import SectionHeader from "../SectionHeader.astro";
import { useTranslations } from "../../i18n/utils";
import type { Lang } from "../../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

/** Layout constants. One coordinate system, four columns left to right. */
const NODE_H = 34;
const COL = { ctx: 26, leader: 286, work: 566, gate: 822 } as const;
const W = { ctx: 156, leader: 176, work: 158, gate: 152 } as const;

/** Column 1 — what gets loaded into the session before anyone types. */
const context = [
  { id: "claude-md", label: "CLAUDE.md", y: 54 },
  { id: "skills", label: "skills", y: 100 },
  { id: "dominio", label: "Dominio", y: 146 },
  { id: "memoria", label: "engram", y: 192 },
];

/** Column 3 — the subagents the leader can fan work out to. */
const workers = [
  { id: "explorer", label: "explorer", y: 40 },
  { id: "researcher", label: "researcher", y: 86 },
  { id: "implementer", label: "implementer", y: 132 },
  { id: "auditor", label: "auditor", y: 178 },
];

/** The hooks band — automation pinned to fixed moments in the session. */
const hooks = [
  { id: "session-start", label: "SessionStart", x: 60, target: COL.ctx + W.ctx / 2 },
  { id: "pre-tool-use", label: "PreToolUse", x: 330, target: COL.leader + W.leader / 2 },
  { id: "subagent-stop", label: "SubagentStop", x: 580, target: COL.work + W.work / 2 },
  { id: "stop", label: "Stop", x: 830, target: COL.gate + W.gate / 2 },
];

const LEADER_Y = 116;
const GATE_Y = 96;
const REVIEW_Y = 158;

/** The four narrated phases. `phase` maps to the `data-phase` values in CSS. */
const phases = [
  { n: 1, label: t("graph.p1.label"), title: t("graph.p1.title"), body: t("graph.p1.body") },
  { n: 2, label: t("graph.p2.label"), title: t("graph.p2.title"), body: t("graph.p2.body") },
  { n: 3, label: t("graph.p3.label"), title: t("graph.p3.title"), body: t("graph.p3.body") },
  { n: 4, label: t("graph.p4.label"), title: t("graph.p4.title"), body: t("graph.p4.body") },
];

/** Elbow connector: out of `x1`, across a midpoint gutter, into `x2`. */
const elbow = (x1: number, y1: number, x2: number, y2: number): string => {
  const mid = x1 + (x2 - x1) / 2;
  return `M ${x1} ${y1} H ${mid} V ${y2} H ${x2}`;
};
---

<section
  class="relative py-24 sm:py-28 border-b overflow-hidden"
  style="border-color: var(--color-border-soft);"
>
  <div class="absolute inset-0 grid-bg pointer-events-none opacity-50"></div>

  <div class="container-prose relative">
    <SectionHeader
      eyebrow={t("graph.eyebrow")}
      title={t("graph.title")}
      subtitle={t("graph.subtitle")}
    />

    <div class="mt-14 grid gap-8 lg:grid-cols-12 lg:gap-10" data-graph data-phase="1">
      {/* the diagram */}
      <div class="lg:col-span-8 min-w-0">
        <div
          class="rounded-xl border p-3 sm:p-5 overflow-x-auto"
          style="border-color: var(--color-border-soft); background: color-mix(in oklab, var(--color-ivory), transparent 25%);"
        >
          <svg
            viewBox="0 0 990 300"
            class="w-full min-w-[640px] h-auto"
            role="img"
            aria-label={t("graph.aria")}
          >
            <defs>
              <linearGradient id="hg-flow" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0%" stop-color="var(--color-sky-500)"></stop>
                <stop offset="100%" stop-color="var(--color-violet-600)"></stop>
              </linearGradient>
              <marker
                id="hg-arrow"
                viewBox="0 0 10 10"
                refX="9"
                refY="5"
                markerWidth="5"
                markerHeight="5"
                orient="auto-start-reverse"
              >
                <path d="M 0 0 L 10 5 L 0 10 z" fill="currentColor"></path>
              </marker>
            </defs>

            {/* column captions */}
            <g class="hg-caption" aria-hidden="true">
              <text x={COL.ctx} y="22">{t("graph.col.context")}</text>
              <text x={COL.leader} y="22">{t("graph.col.orchestration")}</text>
              <text x={COL.work} y="22">{t("graph.col.work")}</text>
              <text x={COL.gate} y="22">{t("graph.col.gate")}</text>
            </g>

            {/* ── phase 1 · context flows into the session ───────────── */}
            <g class="hg-edges hg-p1">
              {
                context.map((c) => (
                  <path
                    class="hg-edge"
                    d={elbow(
                      COL.ctx + W.ctx,
                      c.y + NODE_H / 2,
                      COL.leader,
                      LEADER_Y + NODE_H + 8,
                    )}
                    marker-end="url(#hg-arrow)"
                  />
                ))
              }
            </g>
            <g class="hg-nodes hg-p1">
              {
                context.map((c) => (
                  <>
                    <rect
                      class="hg-node hg-node-ctx"
                      x={COL.ctx}
                      y={c.y}
                      width={W.ctx}
                      height={NODE_H}
                      rx="8"
                    />
                    <text class="hg-label" x={COL.ctx + 14} y={c.y + 22}>
                      {c.label}
                    </text>
                  </>
                ))
              }
            </g>

            {/* ── phase 2 · the leader fans the work out ─────────────── */}
            <g class="hg-edges hg-p2">
              {
                workers.map((w) => (
                  <path
                    class="hg-edge"
                    d={elbow(
                      COL.leader + W.leader,
                      LEADER_Y + NODE_H / 2,
                      COL.work,
                      w.y + NODE_H / 2,
                    )}
                    marker-end="url(#hg-arrow)"
                  />
                ))
              }
            </g>
            <g class="hg-nodes hg-p2">
              <rect
                class="hg-node hg-node-leader"
                x={COL.leader}
                y={LEADER_Y}
                width={W.leader}
                height={NODE_H + 8}
                rx="10"
              />
              <text class="hg-label hg-label-leader" x={COL.leader + 16} y={LEADER_Y + 26}>
                leader
              </text>
              <text class="hg-sub" x={COL.leader + 78} y={LEADER_Y + 26}>
                {t("graph.leader.tag")}
              </text>
            </g>

            {/* ── phase 3 · the workers run, in parallel ─────────────── */}
            <g class="hg-nodes hg-p3">
              {
                workers.map((w) => (
                  <>
                    <rect
                      class="hg-node hg-node-work"
                      x={COL.work}
                      y={w.y}
                      width={W.work}
                      height={NODE_H}
                      rx="8"
                    />
                    <text class="hg-label" x={COL.work + 14} y={w.y + 22}>
                      {w.label}
                    </text>
                  </>
                ))
              }
            </g>

            {/* ── phase 4 · the gate decides ─────────────────────────── */}
            <g class="hg-edges hg-p4">
              {
                workers.map((w) => (
                  <path
                    class="hg-edge"
                    d={elbow(COL.work + W.work, w.y + NODE_H / 2, COL.gate, REVIEW_Y + NODE_H / 2)}
                    marker-end="url(#hg-arrow)"
                  />
                ))
              }
              <path
                class="hg-edge"
                d={`M ${COL.gate + W.gate / 2} ${REVIEW_Y} V ${GATE_Y + NODE_H}`}
                marker-end="url(#hg-arrow)"
              />
            </g>
            <g class="hg-nodes hg-p4">
              <rect
                class="hg-node hg-node-gate"
                x={COL.gate}
                y={GATE_Y}
                width={W.gate}
                height={NODE_H}
                rx="8"
              />
              <text class="hg-label" x={COL.gate + 14} y={GATE_Y + 22}>
                quality gate
              </text>
              <rect
                class="hg-node hg-node-review"
                x={COL.gate}
                y={REVIEW_Y}
                width={W.gate}
                height={NODE_H}
                rx="8"
              />
              <text class="hg-label" x={COL.gate + 14} y={REVIEW_Y + 22}>
                reviewer
              </text>
            </g>

            {/* ── the hooks band — fires across every phase ──────────── */}
            <g class="hg-hooks hg-p3" aria-hidden="true">
              {
                hooks.map((h) => (
                  <>
                    <path class="hg-hook-line" d={`M ${h.target} 244 V 258`} />
                    <rect class="hg-hook" x={h.x} y={258} width="120" height="26" rx="13" />
                    <text class="hg-hook-label" x={h.x + 60} y={275}>
                      {h.label}
                    </text>
                  </>
                ))
              }
              <text class="hg-caption-hooks" x={COL.ctx} y="240">{t("graph.col.hooks")}</text>
            </g>
          </svg>
        </div>

        <p class="mt-3 text-xs text-slate-500 dark:text-slate-400">
          {t("graph.hint")}
        </p>
      </div>

      {/* the narrator */}
      <div class="lg:col-span-4">
        <ol class="flex flex-col gap-2">
          {
            phases.map((p) => (
              <li>
                <button
                  type="button"
                  data-phase-btn={p.n}
                  aria-pressed={p.n === 1 ? "true" : "false"}
                  class="hg-step w-full text-left rounded-lg border p-4 transition-all"
                >
                  <span class="flex items-center gap-2.5">
                    <span class="hg-step-n display-italic text-2xl leading-none tabular-nums">
                      {String(p.n).padStart(2, "0")}
                    </span>
                    <span class="hg-step-label text-[10px] font-mono uppercase tracking-[0.18em]">
                      {p.label}
                    </span>
                  </span>
                  <span class="mt-2 block text-sm font-semibold tracking-tight">{p.title}</span>
                  <span class="mt-1 block text-sm leading-relaxed text-slate-600 dark:text-slate-400">
                    {p.body}
                  </span>
                </button>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  /* ── static styling ─────────────────────────────────────────────── */
  .hg-caption {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    fill: color-mix(in oklab, var(--color-ink), transparent 60%);
  }

  .hg-caption-hooks {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    fill: color-mix(in oklab, var(--color-ink), transparent 60%);
  }

  :global(html.dark) .hg-caption,
  :global(html.dark) .hg-caption-hooks {
    fill: rgb(148 163 184);
  }

  .hg-node {
    fill: color-mix(in oklab, var(--color-ivory), transparent 15%);
    stroke: var(--color-border-soft);
    stroke-width: 1;
  }

  .hg-node-leader {
    fill: color-mix(in oklab, var(--color-violet-600), transparent 88%);
    stroke: var(--color-violet-500);
  }

  .hg-node-gate {
    fill: color-mix(in oklab, var(--color-sky-500), transparent 90%);
    stroke: var(--color-sky-500);
  }

  .hg-label {
    font-family: var(--font-mono);
    font-size: 12px;
    fill: var(--color-ink);
  }

  :global(html.dark) .hg-label {
    fill: rgb(226 232 240);
  }

  .hg-label-leader {
    font-weight: 600;
  }

  .hg-sub {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    fill: var(--color-violet-700);
  }

  :global(html.dark) .hg-sub {
    fill: var(--color-violet-300);
  }

  .hg-edge {
    fill: none;
    stroke: url(#hg-flow);
    stroke-width: 1.5;
    color: var(--color-violet-500);
    stroke-dasharray: 5 5;
  }

  .hg-hook {
    fill: color-mix(in oklab, var(--color-ivory-2), transparent 10%);
    stroke: var(--color-border-soft);
    stroke-width: 1;
    stroke-dasharray: 3 3;
  }

  .hg-hook-label {
    font-family: var(--font-mono);
    font-size: 10px;
    text-anchor: middle;
    fill: color-mix(in oklab, var(--color-ink), transparent 30%);
  }

  :global(html.dark) .hg-hook-label {
    fill: rgb(148 163 184);
  }

  .hg-hook-line {
    stroke: var(--color-border-soft);
    stroke-width: 1;
    stroke-dasharray: 2 3;
  }

  /* ── phase dimming ──────────────────────────────────────────────
   * Everything stays visible — the diagram is one system, not four
   * slides. The inactive parts recede; the active phase gains contrast
   * and its edges start flowing. */
  .hg-p1,
  .hg-p2,
  .hg-p3,
  .hg-p4 {
    opacity: 0.32;
    transition:
      opacity 0.45s ease,
      filter 0.45s ease;
  }

  [data-phase="1"] .hg-p1,
  [data-phase="2"] .hg-p1,
  [data-phase="2"] .hg-p2,
  [data-phase="3"] .hg-p1,
  [data-phase="3"] .hg-p2,
  [data-phase="3"] .hg-p3,
  [data-phase="4"] .hg-p1,
  [data-phase="4"] .hg-p2,
  [data-phase="4"] .hg-p3,
  [data-phase="4"] .hg-p4 {
    opacity: 1;
  }

  /* the active phase's edges animate; earlier ones stay lit but still */
  [data-phase="1"] .hg-p1 .hg-edge,
  [data-phase="2"] .hg-p2 .hg-edge,
  [data-phase="4"] .hg-p4 .hg-edge {
    animation: hgFlow 0.9s linear infinite;
    stroke-width: 2;
  }

  [data-phase="3"] .hg-p3 .hg-node-work {
    stroke: var(--color-sky-500);
    animation: hgPulse 1.6s ease-in-out infinite;
  }

  [data-phase="3"] .hg-p3 .hg-node-work:nth-of-type(2) {
    animation-delay: 0.2s;
  }

  [data-phase="4"] .hg-p4 .hg-node-review {
    stroke: var(--color-violet-500);
    stroke-width: 1.6;
  }

  @keyframes hgFlow {
    to {
      stroke-dashoffset: -20;
    }
  }

  @keyframes hgPulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.55;
    }
  }

  /* ── the narrator steps ─────────────────────────────────────────── */
  .hg-step {
    border-color: var(--color-border-soft);
    background: transparent;
  }

  .hg-step:hover {
    border-color: var(--color-sky-500);
  }

  .hg-step[aria-pressed="true"] {
    background: color-mix(in oklab, var(--color-ivory), transparent 20%);
    border-color: var(--color-violet-500);
  }

  .hg-step-n {
    color: var(--color-slate-300, #cbd5e1);
  }

  .hg-step[aria-pressed="true"] .hg-step-n {
    background: linear-gradient(120deg, var(--color-sky-600) 0%, var(--color-violet-600) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hg-step-label {
    color: color-mix(in oklab, var(--color-ink), transparent 55%);
  }

  .hg-step[aria-pressed="true"] .hg-step-label {
    color: var(--color-violet-700);
  }

  :global(html.dark) .hg-step-label {
    color: rgb(148 163 184);
  }

  :global(html.dark) .hg-step[aria-pressed="true"] .hg-step-label {
    color: var(--color-violet-300);
  }

  /* ── reduced motion: no flow, no auto-advance, everything lit ───── */
  @media (prefers-reduced-motion: reduce) {
    .hg-p1,
    .hg-p2,
    .hg-p3,
    .hg-p4 {
      opacity: 1;
      transition: none;
    }

    .hg-edge,
    .hg-node-work {
      animation: none !important;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-graph]").forEach((root) => {
    const buttons = root.querySelectorAll<HTMLButtonElement>("[data-phase-btn]");
    if (buttons.length === 0) return;

    const PHASES = buttons.length;
    const DWELL_MS = 3600;

    const show = (phase: number): void => {
      root.dataset.phase = String(phase);
      buttons.forEach((b) => {
        b.setAttribute("aria-pressed", b.dataset.phaseBtn === String(phase) ? "true" : "false");
      });
    };

    // A visitor who never touches the diagram still sees all four phases; one
    // who does takes over, and the tour does not fight them for control.
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let timer: ReturnType<typeof setInterval> | undefined;
    let current = 1;

    const stop = (): void => {
      if (timer !== undefined) clearInterval(timer);
      timer = undefined;
    };

    const start = (): void => {
      if (reduced || timer !== undefined) return;
      timer = setInterval(() => {
        current = (current % PHASES) + 1;
        show(current);
      }, DWELL_MS);
    };

    buttons.forEach((btn) => {
      const go = (): void => {
        stop();
        current = Number(btn.dataset.phaseBtn ?? "1");
        show(current);
      };
      btn.addEventListener("click", go);
      btn.addEventListener("focus", go);
    });

    root.addEventListener("mouseenter", stop);
    root.addEventListener("mouseleave", start);

    // Don't animate a diagram nobody is looking at.
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) start();
          else stop();
        }
      },
      { threshold: 0.25 },
    );
    io.observe(root);
  });
</script>
