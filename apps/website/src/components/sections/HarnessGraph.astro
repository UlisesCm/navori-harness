---
import PromptTerminal from "../PromptTerminal.astro";
import WalkthroughScene from "../WalkthroughScene.astro";
import "../../styles/walkthrough.css";
import { walkthrough } from "../../content/walkthrough";
import type { Lang } from "../../i18n/ui";
import { localizedPath } from "../../i18n/utils";
interface Props { lang: Lang; }
const { lang } = Astro.props;
const copy = walkthrough[lang];
const first = copy.steps[0]!;
---
<section id="anatomy" class="walkthrough-section" aria-labelledby="walkthrough-title">
  <div class="container-prose">
    <div class="walkthrough-heading">
      <h2 id="walkthrough-title">{copy.title}</h2>
    </div>
    <div class="walkthrough" data-walkthrough data-scene={first.scene} data-paused="true"
      data-play-label={copy.play} data-pause-label={copy.pause} data-replay-label={copy.replay}>
      <div class="walkthrough-main">
        <PromptTerminal lang={lang} />
        <div class="walkthrough-world">
          <div class="world-topline"><span>{copy.project}</span><span>{copy.example}</span></div>
          <WalkthroughScene lang={lang} />
          <div class="walkthrough-narration" data-walkthrough-narration aria-live="off">
            {copy.steps.map((step, index) => <div data-walkthrough-caption={index} hidden={index !== 0}><h3>{step.title}</h3><p>{step.body}</p></div>)}
          </div>
        </div>
      </div>
      <div class="walkthrough-controls" hidden data-walkthrough-controls>
        <div class="walkthrough-playback">
          <button type="button" data-walkthrough-play aria-pressed="false">{copy.play}</button>
          <button type="button" data-walkthrough-previous aria-label={copy.previous} disabled><span aria-hidden="true">←</span></button>
          <button type="button" data-walkthrough-next aria-label={copy.next}><span aria-hidden="true">→</span></button>
          <span class="walkthrough-position" data-walkthrough-position>1 / {copy.steps.length}</span>
        </div>
        <div class="walkthrough-steps" role="group" aria-label={copy.navigation}>
          {copy.steps.map((step, index) => <button type="button" data-walkthrough-step={index} data-scene-name={step.scene} aria-pressed={index === 0}><span>{String(index + 1).padStart(2, "0")}</span>{step.name}</button>)}
        </div>
      </div>
      <div class="walkthrough-progress" aria-hidden="true"><span data-walkthrough-progress></span></div>
    </div>
    <div class="walkthrough-after">
      <details><summary>{copy.readAll}</summary><p>{copy.introduction}</p><ol>{copy.steps.map((step) => <li><h3>{step.title}</h3><p>{step.body}</p></li>)}</ol></details>
      <a href={localizedPath(lang, "/deep-dive")}>{copy.more}<span aria-hidden="true"> ↗</span></a>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-walkthrough]").forEach((root) => {
    const steps = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-walkthrough-step]"));
    const captions = Array.from(root.querySelectorAll<HTMLElement>("[data-walkthrough-caption]"));
    const scenes = Array.from(root.querySelectorAll<HTMLElement>("[data-stage-scene]"));
    const play = root.querySelector<HTMLButtonElement>("[data-walkthrough-play]");
    const previous = root.querySelector<HTMLButtonElement>("[data-walkthrough-previous]");
    const next = root.querySelector<HTMLButtonElement>("[data-walkthrough-next]");
    const position = root.querySelector<HTMLElement>("[data-walkthrough-position]");
    const progress = root.querySelector<HTMLElement>("[data-walkthrough-progress]");
    const controls = root.querySelector<HTMLElement>("[data-walkthrough-controls]");
    const narration = root.querySelector<HTMLElement>("[data-walkthrough-narration]");
    if (!steps.length || !play || !previous || !next || !position || !progress || !controls) return;
    const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let current = 0;
    let playing = !motion.matches;
    let visible = false;
    let timer: ReturnType<typeof setTimeout> | undefined;
    const clear = (): void => { if (timer !== undefined) window.clearTimeout(timer); timer = undefined; };
    const schedule = (): void => {
      clear();
      if (playing && visible && !document.hidden) timer = window.setTimeout(() => {
        if (current < steps.length - 1) show(current + 1);
        else { playing = false; render(); }
      }, 6500);
    };
    const render = (): void => {
      root.dataset.paused = String(!playing || !visible || document.hidden);
      root.dataset.scene = steps[current]?.dataset.sceneName ?? "workspace";
      narration?.setAttribute("aria-live", playing ? "off" : "polite");
      scenes.forEach((scene) => { scene.hidden = scene.dataset.stageScene !== root.dataset.scene; });
      captions.forEach((caption, index) => { caption.hidden = index !== current; });
      steps.forEach((button, index) => { button.setAttribute("aria-pressed", String(index === current)); });
      previous.disabled = current === 0;
      next.disabled = current === steps.length - 1;
      position.textContent = (current + 1) + " / " + steps.length;
      progress.style.width = ((current + 1) / steps.length * 100) + "%";
      play.textContent = playing ? root.dataset.pauseLabel ?? "" :
        current === steps.length - 1 ? root.dataset.replayLabel ?? "" : root.dataset.playLabel ?? "";
      play.setAttribute("aria-pressed", String(playing));
      schedule();
    };
    const show = (index: number): void => {
      current = Math.max(0, Math.min(steps.length - 1, index));
      render();
    };
    const manual = (index: number): void => { playing = false; show(index); };
    steps.forEach((button, index) => { button.addEventListener("click", () => manual(index)); });
    previous.addEventListener("click", () => manual(current - 1));
    next.addEventListener("click", () => manual(current + 1));
    play.addEventListener("click", () => {
      playing = !playing;
      if (playing && current === steps.length - 1) current = 0;
      render();
    });
    motion.addEventListener("change", () => { if (motion.matches) playing = false; render(); });
    document.addEventListener("visibilitychange", render);
    const observer = new IntersectionObserver((entries: IntersectionObserverEntry[]) => {
      visible = entries.some((entry) => entry.isIntersecting);
      render();
    }, { threshold: 0.15 });
    observer.observe(root);
    controls.hidden = false;
    render();
    document.addEventListener("astro:before-swap", () => { clear(); observer.disconnect(); }, { once: true });
  });
</script>
