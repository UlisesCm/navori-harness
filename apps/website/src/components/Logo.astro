---
import { getLangFromUrl, localizedPath, useTranslations } from "../i18n/utils";
interface Props { size?: number; withWordmark?: boolean; class?: string; }
const { class: className = "" } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<a href={localizedPath(lang, "/")} class:list={["brand-logo inline-flex items-center", className]} aria-label={t("logo.home")}>
  <span class="brand-name">navori</span>
</a>
