---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { useTranslations, localizedPath } from "../i18n/utils";
import type { Lang } from "../i18n/ui";
import { locales, localeOrder } from "../i18n/locales";
import { pageFromPath, pagePath, markdownPath, indexPath } from "../content/pages";
import { REPO_URL } from "../consts";
import cliPkg from "../../../../packages/cli/package.json";

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  pathname?: string;
  /** Share image, relative to the site base. Defaults to the per-language OG card. */
  image?: string;
  /** Path of this page in the OTHER language, when the slug differs (e.g. /versiones ↔ /releases). */
  altSlug?: string;
}

const { lang, title, description, pathname = Astro.url.pathname, image, altSlug } = Astro.props;
const t = useTranslations(lang);
const page = pageFromPath(pathname, import.meta.env.BASE_URL);

const pageTitle = title ? `${title} — navori` : `navori — ${t("site.tagline")}`;
const pageDescription = description ?? t("site.description");

const siteOrigin = Astro.site ?? new URL("https://ulisescm.github.io");
const canonicalUrl = new URL(pagePath(lang, page, import.meta.env.BASE_URL), siteOrigin).toString();

const alternates = localeOrder.map((locale) => ({locale, href: new URL(pagePath(locale, page, import.meta.env.BASE_URL), siteOrigin).href}));
const ogFile = image ?? locales[lang].image;
const ogImage = new URL(`${import.meta.env.BASE_URL}${ogFile}`, siteOrigin).href;
const llmsUrl = new URL(indexPath(lang, import.meta.env.BASE_URL), siteOrigin).href;
const markdownUrl = new URL(markdownPath(lang, page, import.meta.env.BASE_URL), siteOrigin).href;

/**
 * Structured data. Agents and search crawlers both read this; it states in one
 * machine-readable place what the prose says in two languages.
 */
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "navori",
  description: pageDescription,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "macOS, Linux, Windows",
  softwareVersion: cliPkg.version,
  url: canonicalUrl,
  license: "https://opensource.org/licenses/MIT",
  codeRepository: REPO_URL,
  downloadUrl: "https://www.npmjs.com/package/navori",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  keywords: [
    "AI harness",
    "multi-agent",
    "spec-driven development",
    "Claude Code",
    "Codex",
    "Cursor",
    "GitHub Copilot",
    "AGENTS.md",
    "scaffolder",
  ],
};
---

<!doctype html>
<html lang={locales[lang].html}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fafaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0f1f" media="(prefers-color-scheme: dark)" />

    <link rel="canonical" href={canonicalUrl} />
    {alternates.map(({locale,href}) => <link rel="alternate" hreflang={locale} href={href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates[0].href} />
    <link rel="describedby" type="text/plain" href={llmsUrl} title="llms.txt" />
    <link rel="alternate" type="text/markdown" href={markdownUrl} />

    <meta property="og:site_name" content="navori" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={locales[lang].og} />
    {localeOrder.filter((locale) => locale !== lang).map((locale) => <meta property="og:locale:alternate" content={locales[locale].og} />)}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`navori — ${t("site.tagline")}`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={`navori — ${t("site.tagline")}`} />

    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>
  <body>
    <Header lang={lang} page={page} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
