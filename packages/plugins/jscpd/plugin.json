{
  "id": "jscpd",
  "name": "jscpd (code duplication detector)",
  "description": "Detección de duplicación de código en el diff vs branch base",
  "version": "0.0.5",
  "managed": [],
  "externalTool": {
    "name": "jscpd",
    "checkBinary": "jscpd",
    "install": {
      "darwin": "pnpm add -g jscpd",
      "linux": "pnpm add -g jscpd",
      "win32": "pnpm add -g jscpd"
    }
  },
  "scripts": [
    {
      "src": "scripts/check-jscpd.sh",
      "dest": "check-jscpd.sh",
      "exec": true
    }
  ],
  "hooks": [
    {
      "event": "PreToolUse",
      "matcher": "Bash",
      "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/scripts/check-jscpd.sh\"",
      "timeout": 180,
      "statusMessage": "navori/jscpd: dup check"
    }
  ],
  "invariants": [
    "jscpd",
    "do not approve"
  ],
  "skills": [
    {
      "id": "jscpd-review-extension",
      "file": "skills/jscpd-review.md",
      "recommendedAgent": "reviewer",
      "injectInto": ".claude/skills/review-diff/SKILL.md"
    }
  ]
}
