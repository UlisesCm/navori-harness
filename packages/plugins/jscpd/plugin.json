{
  "id": "jscpd",
  "name": "jscpd (code duplication detector)",
  "description": "Detección de duplicación de código en el diff vs branch base",
  "version": "0.0.6",
  "managed": [],
  "externalTool": {
    "name": "jscpd",
    "checkBinary": "jscpd",
    "install": {
      "darwin": "pnpm add -g jscpd@^5.1.1",
      "linux": "pnpm add -g jscpd@^5.1.1",
      "win32": "pnpm add -g jscpd@^5.1.1"
    },
    "installDocs": "https://github.com/kucherenko/jscpd",
    "capabilityProbe": {
      "args": ["--help"],
      "mustContain": ["--baseline-from-ref", "--fail-on-new-clones"],
      "minVersion": "5.1.1"
    }
  },
  "settingsFragment": {
    "permissions": {
      "allow": [
        "Bash(jscpd:*)"
      ]
    }
  },
  "scripts": [
    {
      "src": "scripts/check-jscpd.sh",
      "dest": "check-jscpd.sh",
      "exec": true
    }
  ],
  "hooks": [
    {
      "event": "PreToolUse",
      "matcher": "Bash",
      "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/scripts/check-jscpd.sh\"",
      "timeout": 600,
      "statusMessage": "navori/jscpd: dup check"
    }
  ],
  "invariants": [
    "jscpd",
    "do not approve"
  ],
  "skills": [
    {
      "id": "jscpd-review-extension",
      "file": "skills/jscpd-review.md",
      "recommendedAgent": "reviewer",
      "injectInto": ".claude/skills/review-diff/SKILL.md"
    }
  ]
}
