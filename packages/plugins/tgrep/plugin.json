{
  "id": "tgrep",
  "name": "Microsoft tgrep textual discovery",
  "description": "Textual code discovery through the tgrep CLI",
  "version": "0.0.1",
  "managed": [
    { "id": "tgrep-search-v2", "file": "managed/tgrep-search-v2.md" }
  ],
  "externalTool": {
    "name": "tgrep",
    "checkBinary": "tgrep",
    "install": {
      "darwin": "brew install tgrep",
      "linux": "brew install tgrep"
    },
    "installDocs": "https://github.com/microsoft/tgrep"
  },
  "settingsFragment": {
    "permissions": {
      "allow": ["Bash(tgrep search *)", "Bash(tgrep status:*)", "Bash(tgrep --version)"]
    }
  },
  "scripts": [
    { "src": "scripts/guard-search-routing.sh", "dest": "guard-search-routing.sh", "exec": true }
  ],
  "hookExtensions": [
    {
      "id": "tgrep-search-lane",
      "target": ".claude/hooks/guard-destructive.sh",
      "file": "managed/guard-destructive-search-lane.sh"
    }
  ],
  "invariants": ["tgrep search", "--no-index"]
}
