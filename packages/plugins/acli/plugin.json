{
  "id": "acli",
  "name": "Atlassian CLI (Jira tickets)",
  "description": "Lectura de tickets de Jira desde la terminal sin abrir el browser",
  "version": "0.0.1",
  "managed": [
    {
      "id": "acli-protocol",
      "file": "managed/acli-protocol.md",
      "recommendedAgent": "scout"
    }
  ],
  "externalTool": {
    "name": "acli",
    "checkBinary": "acli",
    "install": {
      "darwin": "brew install atlassian/acli/acli",
      "linux": "curl -fsSL https://acli.atlassian.com/install.sh | bash"
    }
  },
  "settingsFragment": {
    "permissions": {
      "allow": [
        "Bash(acli jira workitem view*)",
        "Bash(acli jira workitem search*)",
        "Bash(acli jira workitem comment list*)",
        "Bash(acli jira workitem transition list*)"
      ]
    }
  },
  "invariants": ["acli jira workitem view"],
  "skills": [
    {
      "id": "acli-comment-channel-publisher",
      "file": "skills/acli-comment-channel.md",
      "recommendedAgent": "publisher",
      "injectInto": ".claude/agents/publisher.md"
    }
  ]
}
