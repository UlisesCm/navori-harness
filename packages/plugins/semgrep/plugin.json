{
  "id": "semgrep",
  "name": "semgrep (security + pattern analysis)",
  "description": "Detección de vulnerabilidades y patrones inseguros local opt-in",
  "version": "0.0.5",
  "managed": [],
  "externalTool": {
    "name": "semgrep",
    "checkBinary": "semgrep",
    "install": {
      "darwin": "brew install semgrep",
      "linux": "command -v pipx >/dev/null 2>&1 && pipx install semgrep || pip3 install --user semgrep"
    }
  },
  "scripts": [
    {
      "src": "scripts/check-semgrep.sh",
      "dest": "check-semgrep.sh",
      "exec": true
    }
  ],
  "hooks": [
    {
      "event": "PreToolUse",
      "matcher": "Bash",
      "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/scripts/check-semgrep.sh\"",
      "timeout": 180,
      "statusMessage": "navori/semgrep: security scan"
    }
  ],
  "invariants": [
    "run semgrep over the diff"
  ],
  "skills": [
    {
      "id": "semgrep-review-extension",
      "file": "skills/semgrep-review.md",
      "recommendedAgent": "reviewer",
      "injectInto": ".claude/skills/security-guidance/SKILL.md"
    }
  ]
}
