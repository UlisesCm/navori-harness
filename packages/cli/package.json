{
  "name": "navori",
  "version": "0.9.0",
  "description": "Multi-agent harness + SDD scaffolder for Claude Code and other AI engines",
  "type": "module",
  "bin": {
    "navori": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "claude-code",
    "ai",
    "scaffolder",
    "harness",
    "agents",
    "sdd",
    "multi-agent"
  ],
  "features": {
    "plugins": 7,
    "presets": 12,
    "coreAgents": 8,
    "coreSkills": 16,
    "librarySkills": 36
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UlisesCm/navori-harness.git"
  },
  "homepage": "https://ulisescm.github.io/navori-harness/",
  "scripts": {
    "build": "tsdown -c tsdown.config.ts && node scripts/copy-assets.mjs",
    "dev": "tsdown -c tsdown.config.ts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage && node scripts/check-coverage-floor.mjs",
    "test:golden": "vitest run golden-render-tree --update",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit --allowImportingTsExtensions",
    "gen:schemas": "node scripts/gen-schemas.mjs",
    "check:size": "node scripts/check-bundle-size.mjs",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "@clack/prompts": "^0.10.0",
    "@navori/core": "workspace:*",
    "@navori/plugin-acli": "workspace:*",
    "@navori/plugin-codegraph": "workspace:*",
    "@navori/plugin-engram": "workspace:*",
    "@navori/plugin-gh": "workspace:*",
    "@navori/plugin-jscpd": "workspace:*",
    "@navori/plugin-semgrep": "workspace:*",
    "@navori/plugin-tgrep": "workspace:*",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.1",
    "citty": "^0.1.6",
    "picocolors": "^1.1.1",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=22.12"
  }
}
