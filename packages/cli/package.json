{
  "name": "navori",
  "version": "0.12.2",
  "description": "Multi-agent harness + SDD scaffolder for Claude Code and other AI engines",
  "type": "module",
  "bin": {
    "navori": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "claude-code",
    "ai",
    "scaffolder",
    "harness",
    "agents",
    "sdd",
    "multi-agent"
  ],
  "features": {
    "plugins": 5,
    "presets": 13,
    "coreAgents": 8,
    "coreSkills": 18,
    "librarySkills": 48
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UlisesCm/navori-harness.git"
  },
  "homepage": "https://ulisescm.github.io/navori-harness/",
  "scripts": {
    "build": "tsdown -c tsdown.config.ts && node scripts/copy-assets.mjs",
    "dev": "tsdown -c tsdown.config.ts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "node scripts/run-test-coverage.mjs",
    "test:golden": "vitest run golden-render-tree --update",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit --allowImportingTsExtensions",
    "gen:schemas": "node scripts/gen-schemas.mjs",
    "check:size": "node scripts/check-bundle-size.mjs",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "@clack/prompts": "^1.8.1",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@navori/core": "workspace:*",
    "@navori/plugin-acli": "workspace:*",
    "@navori/plugin-codegraph": "workspace:*",
    "@navori/plugin-engram": "workspace:*",
    "@navori/plugin-gh": "workspace:*",
    "@navori/plugin-tgrep": "workspace:*",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "citty": "^0.2.2",
    "picocolors": "^1.1.1",
    "smol-toml": "^1.9.1",
    "tsdown": "^0.23.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22.12"
  }
}
