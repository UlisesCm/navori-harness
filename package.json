{
  "name": "navori-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/*",
    "packages/plugins/*",
    "apps/*"
  ],
  "trustedDependencies": [
    "@ast-grep/cli",
    "esbuild",
    "sharp"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "bun run --filter '*' build",
    "dev": "bun run --filter '*' dev",
    "lint": "oxlint packages/cli/src",
    "typecheck": "bun run --filter navori typecheck",
    "gen:schemas": "bun run --filter navori gen:schemas",
    "format": "oxfmt \"packages/cli/src/**/*.{ts,tsx}\" \"apps/website/src/**/*.{ts,tsx}\"",
    "format:check": "oxfmt --check \"packages/cli/src/**/*.{ts,tsx}\" \"apps/website/src/**/*.{ts,tsx}\"",
    "test:affected": "node packages/cli/scripts/test-affected.mjs",
    "bench:tests": "node packages/cli/scripts/bench-tests.mjs",
    "bench:hooks": "node scripts/js/bench-hooks.mjs",
    "bench:context": "node scripts/js/bench-context.mjs",
    "check:links": "node scripts/js/check-links.mjs",
    "ensure-dist": "bun packages/cli/scripts/ensure-dist.ts",
    "check:render": "bun packages/cli/scripts/check-render-locked.ts",
    "check:assets": "node scripts/js/check-asset-commands.mjs",
    "check:assets:ci": "node scripts/js/check-asset-commands.mjs --strict",
    "check:doc-budgets": "node packages/cli/scripts/check-doc-budgets.mjs",
    "check:blame-ignore": "node scripts/js/check-blame-ignore.mjs",
    "check:tests-preserved": "node scripts/js/check-test-preservation.mjs",
    "check:dup": "./node_modules/.bin/jscpd -r silent || (./node_modules/.bin/jscpd; exit 1)",
    "check:dup:baseline": "./node_modules/.bin/jscpd --update-baseline",
    "check:ast": "./node_modules/.bin/ast-grep test --skip-snapshot-tests && ./node_modules/.bin/ast-grep scan",
    "prepare": "bun run hooks:install",
    "hooks:install": "node scripts/js/install-git-hooks.mjs",
    "render:apply": "bun run --filter navori build && node packages/cli/dist/index.js render --apply",
    "check:scoped": "bun run format:check && bun run lint && bun run typecheck && bun run check:dup && bun run check:ast && bun run check:links && bun run check:render && bun run check:assets && bun run check:doc-budgets && bun run check:blame-ignore && cd packages/cli && bun run check:size",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run check:dup && bun run check:ast && bun run check:links && bun run check:render && bun run check:assets && bun run check:doc-budgets && bun run check:blame-ignore && bun run check:tests-preserved && cd packages/cli && bun run check:size && bun run test:coverage",
    "check:fast": "bun run format:check && bun run lint && bun run typecheck && bun run check:dup && bun run check:ast"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.45.3",
    "jscpd": "5.4.0",
    "oxfmt": "^0.70.0",
    "oxlint": "1.75.0"
  }
}
