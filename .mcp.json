{
  "$navori": {
    "managed": true,
    "version": "0.9.0"
  },
  "mcpServers": {
    "engram": {
      "command": "engram",
      "args": [
        "mcp",
        "--tools=agent"
      ]
    },
    "codegraph": {
      "command": "codegraph",
      "args": [
        "serve",
        "--mcp"
      ],
      "env": {
        "CODEGRAPH_MCP_TOOLS": "explore",
        "CODEGRAPH_EXPLORE_DEDUP": "0"
      },
      "alwaysLoad": true
    }
  }
}
