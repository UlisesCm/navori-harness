{
  "$schema": "https://ulisescm.github.io/navori-harness/schema/navori.config.v1.json",
  "name": "navori-harness",
  "version": "1.0.0",
  "engines": [
    "claude",
    "codex"
  ],
  "preset": "custom",
  "language": "es",
  "branchBase": "main",
  "gitignoreHarness": "off",
  "commits": "conventional-es",
  "models": {
    "leader": "sonnet",
    "implementer": "sonnet",
    "reviewer": "sonnet",
    "researcher": "haiku",
    "ticketAudit": "sonnet",
    "commitPrPilot": "haiku",
    "explorer": "haiku",
    "auditor": "sonnet"
  },
  "effort": {
    "leader": "high",
    "implementer": "medium",
    "reviewer": "low",
    "researcher": "high",
    "ticketAudit": "medium",
    "commitPrPilot": "low",
    "explorer": "low",
    "auditor": "medium"
  },
  "qualityGate": {
    "fast": "cd packages/cli && pnpm lint",
    "full": "pnpm format:check && pnpm check:links && pnpm check:render && pnpm check:assets && pnpm check:doc-budgets && pnpm jscpd:check && pnpm semgrep:check && cd packages/cli && pnpm check:size && pnpm test:coverage && pnpm lint && pnpm typecheck"
  },
  "plugins": {
    "engram": {
      "enabled": true
    },
    "gh": {
      "enabled": true
    },
    "jscpd": {
      "enabled": true
    },
    "semgrep": {
      "enabled": true
    }
  },
  "project": {
    "legacyPaths": [],
    "criticalAreas": [
      "render/sync/backup writes and deletes in the user's repo",
      "settings.json permissions, deny/ask rules and hooks",
      "managed-block markers and the anti-rollback guard"
    ],
    "testsExclude": [],
    "localSkills": [
      "playwright-cli"
    ],
    "libraries": [
      "zod-validation",
      "vitest",
      "citty",
      "clack"
    ],
    "libraryMigrations": []
  },
  "audit": {
    "mode": "always"
  }
}
