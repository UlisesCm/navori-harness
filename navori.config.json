{
  "$schema": "https://ulisescm.github.io/navori-harness/schema/navori.config.v1.json",
  "name": "navori-harness",
  "version": "1.0.0",
  "engines": [
    "claude"
  ],
  "preset": "custom",
  "language": "es",
  "branchBase": "main",
  "gitignoreHarness": "off",
  "commits": "conventional-es",
  "qualityGate": {
    "fast": "cd packages/cli && pnpm lint",
    "full": "pnpm format:check && pnpm check:render && pnpm check:assets && pnpm --filter @navori/website build && cd packages/cli && pnpm check:size && pnpm test:coverage && pnpm lint && pnpm typecheck"
  },
  "plugins": {
    "engram": {
      "enabled": true
    },
    "gh": {
      "enabled": true
    },
    "jscpd": {
      "enabled": true
    },
    "semgrep": {
      "enabled": true
    },
    "codegraph": {
      "enabled": true
    },
    "tgrep": {
      "enabled": true
    }
  },
  "project": {
    "legacyPaths": [],
    "criticalAreas": [
      "render/sync/backup writes and deletes in the user's repo",
      "settings.json permissions, deny/ask rules and hooks",
      "managed-block markers and the anti-rollback guard"
    ],
    "testsExclude": [],
    "localSkills": [
      "playwright-cli"
    ],
    "libraries": [
      "zod-validation",
      "vitest",
      "citty",
      "clack"
    ],
    "libraryMigrations": []
  },
  "audit": {
    "mode": "always"
  }
}
